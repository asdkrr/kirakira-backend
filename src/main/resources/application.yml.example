server:
  port: 7070

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/kirakira?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: kirakira
    password:  answer
  # 表已经用 schema-mysql.sql 手动建好了，不再让 Spring 自动初始化
  sql:
    init:
      mode: never

mybatis-plus:
  configuration:
    # 数据库的 upload_date 自动映射到 Java 的 uploadDate
    map-underscore-to-camel-case: true
    # 开发时把执行的 SQL 打出来，方便你观察
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto

# JWT 配置。secret 至少 32 个字符（HS256 要求 256 位密钥）。
# 真实项目请放到环境变量里，不要提交到 Git。
jwt:
  secret: kirakira-dev-secret-key-change-me-in-production-0123456789
  expire-hours: 168

